# virtara-backend environment. Copy to .env for local runs; set the same
# names in Vercel (Settings > Environment Variables). Never commit values.

# Website lead capture: /api/lead forwards every form to Virtec.
# VIRTEC_BASE_URL is the Virtec deployment, e.g. https://crm.example.com
VIRTEC_BASE_URL=
# Must equal VIRTARA_SITE_LEADS_KEY in the Virtec project. 24+ characters,
# generate with: openssl rand -hex 32
VIRTARA_SITE_LEADS_KEY=

# Fallback email when Virtec cannot take a lead (and /api/send-email).
RESEND_API_KEY=

# Health check signups (Sender.net).
SENDER_API_KEY=
SENDER_LIST_ID=
