{
    "version": 2,
    "builds": [
      {
        "src": "index.js",
        "use": "@vercel/node"
      },
      {
        "src": "public/**",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/files/(.*)",
        "dest": "/public/$1",
        "headers": {
        "Content-Disposition": "attachment; filename=\"website-health-check.pdf\"",
        "Content-Type": "application/pdf",
        "Cache-Control": "public, max-age=31536000"
      }
      },
      {
        "src": "/api/(.*)",
        "dest": "/index.js"
      },
      {
        "src": "/(.*)",
        "dest": "/index.js"
      }
    ]
  }